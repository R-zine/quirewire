{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "PrintBridge Project",
    "shortDescription": "Local USB-to-IPP printing bridge",
    "longDescription": "PrintBridge connects an owner-selected USB printer to the Windows inbox IPP print stack through a private Linux guest.",
    "resources": {
      "../../../target/release/printbridge-agent.exe": "bin/printbridge-agent.exe",
      "../../../target/release/printbridgectl.exe": "bin/printbridgectl.exe",
      "../../../scripts/m5/windows/Invoke-M5WindowsPrinting.ps1": "scripts/m5/windows/Invoke-M5WindowsPrinting.ps1",
      "../../../scripts/m6/windows/Invoke-M6Startup.ps1": "scripts/m6/windows/Invoke-M6Startup.ps1",
      "../../../scripts/m6/windows/New-M6Configuration.ps1": "scripts/m6/windows/New-M6Configuration.ps1",
      "../../../scripts/m8/windows/Invoke-M8Lifecycle.ps1": "scripts/m8/windows/Invoke-M8Lifecycle.ps1",
      "../../../scripts/m8/windows/Test-M8Prerequisites.ps1": "scripts/m8/windows/Test-M8Prerequisites.ps1",
      "../../../scripts/m8/windows/Trace-M8ProcessStarts.ps1": "scripts/m8/windows/Trace-M8ProcessStarts.ps1",
      "../../../scripts/m10/windows/Invoke-M10LanSharing.ps1": "scripts/m10/windows/Invoke-M10LanSharing.ps1",
      "../../../scripts/m10/windows/Set-M10LanApproval.ps1": "scripts/m10/windows/Set-M10LanApproval.ps1",
      "../../../scripts/m10/windows/Test-M10LanIpp.ps1": "scripts/m10/windows/Test-M10LanIpp.ps1",
      "../../../guest/": "guest/",
      "../../../docs/install.md": "docs/install.md",
      "../../../docs/licensing.md": "docs/licensing.md"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "skip"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh",
        "startMenuFolder": "PrintBridge"
      }
    }
  }
}
