{
  "name": "quirewire-desktop-ui",
  "private": true,
  "version": "0.1.0",
  "license": "MIT OR Apache-2.0",
  "description": "On-demand local-network printing and scanning for a USB multifunction device",
  "engines": {
    "node": ">=24.15.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --port 1420",
    "dev:fake": "vite --port 1420 --mode fake",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
